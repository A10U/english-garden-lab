# Publish only the app, speech tools, and demo entry point.
/*
!/.gitignore
!/README.md
!/index.html
!/.openai/
!/app/
!/speech-training/
!/package.json
!/package-lock.json
!/vite.config.ts
!/next.config.ts
!/tsconfig.json
!/cloudflare-env.d.ts
!/.npmrc
!/scripts/
!/lib/
!/worker/
!/server/
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
*.log
.DS_Store
.env
.env.*
# Personal API credentials for local speech development/training.
.env.speech-cloud
.env.speech-training
!.env.example
*.pem
*.key
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.gguf
*.tar.gz
*.zip
/speech-training/models/
/speech-training/data/
/speech-training/runs/
/speech-training/.cache/
/speech-training/recordings/
/speech-training/uploads/
/speech-training/dist/
/app/dist/
/.openai/*
!/.openai/hosting.json

# Generated test reports
*.tap
coverage/
.wrangler/
.vinext/
.next/
.sites-runtime/
*.tsbuildinfo
.pytest_cache/
